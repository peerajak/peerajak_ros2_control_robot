<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share peerajak_ros2_control_robot_description)/urdf/peerajak_ros2_control_robot.urdf.xacro" />
    <let name="rviz_config_path"
         value="$(find-pkg-share peerajak_ros2_control_robot_description)/rviz/urdf_config.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share peerajak_ros2_control_robot_bringup)/config/peerajak_ros2_control_robot_controllers.yaml" />
        <remap from="/controller_manager/robot_description" to="/robot_description"/>
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />

    <node pkg="controller_manager" exec="spawner" args="diff_drive_controller" />
    
    <!-- use buid in arm_joints_controller-->
    <!--node pkg="controller_manager" exec="spawner" args="arm_joints_controller" /--> <!-- name of the args is from yaml file that we arbitarily choose-->

    <!-- use custom build my_arm_controller-->
    <node pkg="controller_manager" exec="spawner" args="my_arm_controller" />


    <node pkg="rviz2" exec="rviz2" output="screen" 
          args="-d $(var rviz_config_path)" />
</launch>